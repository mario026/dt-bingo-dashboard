{
  "name": "wom-competition-boss-export",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "export": "node --experimental-strip-types scripts/export-competition.ts",
    "test": "node --experimental-strip-types --test scripts/export-competition.test.ts && vitest run",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "playwright test",
    "assets:wiki": "node --experimental-strip-types scripts/cache-wiki-assets.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.64.1",
    "@primeuix/themes": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "echarts": "^6.1.0",
    "primeicons": "^8.0.2",
    "primevue": "^4.4.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-tsc": "^3.3.13"
  },
  "devDependencies": {
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~5.9.3"
  }
}
